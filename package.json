{
  "name": "elizabeth-davidson-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static rebuild of elizabethdavidson.com (Eleventy + Netlify)",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve --port 8090",
    "import-blog": "node scripts/import-wix-blog.mjs",
    "preview": "eleventy --quiet && node scripts/serve.mjs",
    "check-links": "node scripts/check-links.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0"
  }
}
