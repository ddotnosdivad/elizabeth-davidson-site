<script>
  // Testimonial slider: arrows, dots, and an 8s auto-advance that stops once someone clicks.
  document.querySelectorAll('[data-slider]').forEach((el) => {
    const slides = [...el.querySelectorAll('.slide')];
    const dots = el.querySelector('.dots');
    let i = 0, timer;
    const show = (n) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      [...dots.children].forEach((d, k) => d.setAttribute('aria-current', k === i));
    };
    slides.forEach((_, k) => {
      const b = document.createElement('button');
      b.setAttribute('aria-label', `Testimonial ${k + 1}`);
      b.onclick = () => { clearInterval(timer); show(k); };
      dots.append(b);
    });
    el.querySelector('.prev').onclick = () => { clearInterval(timer); show(i - 1); };
    el.querySelector('.next').onclick = () => { clearInterval(timer); show(i + 1); };
    show(0);
    timer = setInterval(() => show(i + 1), 8000);
  });
</script>
